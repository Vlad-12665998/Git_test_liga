+package UI;
+
+import base.BaseTest;
+import org.openqa.selenium.By;
+import org.openqa.selenium.WebElement;
+import org.openqa.selenium.interactions.Actions;
+import org.testng.Assert;
+import org.testng.annotations.Test;
+
+public class DoubleButtonTest extends BaseTest {
+
+    private static final String BUTTONS_PAGE_URL = "https://demoqa.com/buttons";
+    private static final By DOUBLE_CLICK_BUTTON = By.id("doubleClickBtn");
+    private static final By DOUBLE_CLICK_MESSAGE = By.id("doubleClickMessage");
+
+    @Test
+    public void testDoubleClickButton() {
+        // 1. Загружаем страницу с кнопками
+        driver.get(BUTTONS_PAGE_URL);
+
+        // 2. Двойной клик по кнопке
+        WebElement button = driver.findElement(DOUBLE_CLICK_BUTTON);
+        new Actions(driver).doubleClick(button).perform();
+
+        // 3. Проверка текста
+        String actualText = driver.findElement(DOUBLE_CLICK_MESSAGE).getText();
+        Assert.assertEquals(actualText, "You have done a double click");
+    }
+}
