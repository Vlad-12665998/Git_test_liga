+package UI;
+
+import base.BaseTest;
+import org.openqa.selenium.By;
+import org.openqa.selenium.WebElement;
+import org.openqa.selenium.interactions.Actions;
+import org.testng.Assert;
+import org.testng.annotations.Test;
+
+public class RightButtonTest extends BaseTest {
+
+    private static final String BUTTONS_PAGE_URL = "https://demoqa.com/buttons";
+    private static final By RIGHT_CLICK_BUTTON = By.id("rightClickBtn");
+    private static final By RIGHT_CLICK_MESSAGE = By.id("rightClickMessage");
+
+    @Test
+    public void testRightClickButton() {
+        // 1. Загружаем страницу с кнопками
+        driver.get(BUTTONS_PAGE_URL);
+
+        // 2. Правый клик по кнопке
+        WebElement button = driver.findElement(RIGHT_CLICK_BUTTON);
+        new Actions(driver).contextClick(button).perform();
+
+        // 3. Проверка текста
+        String actualText = driver.findElement(RIGHT_CLICK_MESSAGE).getText();
+        Assert.assertEquals(actualText, "You have done a right click");
+    }
+}
