@@ -0,0 +1,27 @@
+package UI;
+
+import base.BaseTest;
+import org.openqa.selenium.By;
+import org.testng.Assert;
+import org.testng.annotations.Test;
+
+public class ButtonTest extends BaseTest {
+
+    private static final String BUTTONS_PAGE_URL = "https://demoqa.com/buttons";
+    private static final By CLICK_ME_BUTTON = By.xpath("//button[text()='Click Me']");
+    private static final By DYNAMIC_CLICK_MESSAGE = By.id("dynamicClickMessage");
+
+    @Test
+    public void testDynamicClickButton() {
+        // 1. Загружаем страницу с элементами "Buttons"
+        driver.get(BUTTONS_PAGE_URL);
+
+        // 2. Нажимаем на кнопку "Click Me"
+        driver.findElement(CLICK_ME_BUTTON).click();
+
+        // Проверяем появление текста "You have done a dynamic click"
+        String actualText = driver.findElement(DYNAMIC_CLICK_MESSAGE).getText();
+        Assert.assertEquals(actualText, "You have done a dynamic click",
+                "Текст после клика не соответствует ожидаемому");
+    }
+}
